# Cradilot reads this file once at startup. Real environment variables always win,
# so a deployment can ignore this file entirely and set the same names for real.
#
# Copy to .env and fill in. .env is gitignored: never commit a key to it.

# ─── Which engine answers the narrative layers ────────────────────────────────
# ollama | gemini | openai | off
# Leave it unset and Cradilot picks from whatever credential below is present.
# With none of them set, provider=off: the deterministic engines still produce the
# scores, pain points and roadmap, and every AI-written passage says it is degraded.
CRADILOT_LLM_PROVIDER=

# ─── Credentials (pick ONE, paste it yourself, leave the rest blank) ──────────
# Google AI Studio key. Also accepted under the GOOGLE_API_KEY name.
GEMINI_API_KEY=
# Any OpenAI-compatible endpoint: OpenAI itself, OpenRouter, DeepSeek, a local
# llama.cpp or vLLM server.
OPENAI_API_KEY=

# ─── Model per provider ───────────────────────────────────────────────────────
# Defaults: gemini -> gemini-2.5-flash, openai -> gpt-4o-mini, ollama -> gemma3:12b
# CRADILOT_MODEL=

# ─── Self-hosted engine ───────────────────────────────────────────────────────
# Required for CRADILOT_LLM_PROVIDER=ollama. No default on purpose: the server is
# wherever you put it, and a guessed address is how a demo silently runs on canned copy.
# CRADILOT_OLLAMA_URL=
# CRADILOT_OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Who is doing the selling ─────────────────────────────────────────────────
# Everything the customer sees — console header, PDF letterhead, talk tracks — takes
# these three values. Nothing in static/ hardcodes a company name.
CRADILOT_VENDOR_NAME=Your Company
CRADILOT_VENDOR_DOMAIN=your-company.example
CRADILOT_VENDOR_TAGLINE=Digital Growth Advisory

# Your own price list. Schema and the fields each SKU must carry: docs/ADAPTING.md
# CRADILOT_PRODUCT_CATALOG=./data/product_catalog.json

# Case reference stamped on report IDs.
CRADILOT_REPORT_PREFIX=CRDL

# ─── HTTP surface ─────────────────────────────────────────────────────────────
# Empty is the secure setting: the console is served by this same process, so it
# needs no cross-origin allowance. Comma-separated origins only if you split front
# and back end onto different hosts.
CRADILOT_ALLOWED_ORIGINS=
